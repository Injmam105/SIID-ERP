# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key for signing session JWTs and OTP verification tokens.
JWT_SECRET="replace_with_strong_64_char_random_secret"

# OWNER_SETUP_SECRET: Optional setup passcode required during first-time Owner (9650598785) bootstrap.
OWNER_SETUP_SECRET=""

# MYSQL DATABASE CONFIGURATION (Production MySQL 8.0+)
# When MYSQL_HOST and MYSQL_DATABASE are set, the backend connects to MySQL automatically.
# Otherwise, it uses local relational SQL persistence (data/siid_erp.db) for sandbox preview.
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE="siid_erp"

# REAL SMS OTP CONFIGURATION (Required for Employee & Client Self-Registration OTP)
# Supported providers: twilio | fast2sms | msg91
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FAST2SMS_API_KEY=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
